{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "vite-dev",
      "type": "npm",
      "script": "dev",
      "path": "frontend",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "ready in .*|Local:.*"
        }
      }
    }
  ]
}
